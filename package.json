{
  "name": "ai-youtube-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Semi-autonomous multi-agent pipeline that produces a weekly YouTube episode + Shorts.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/index.ts --demo",
    "demo:video": "tsx scripts/demo.ts",
    "music:gen": "node scripts/sparx_music_gen.mjs",
    "ab": "tsx scripts/ab.ts",
    "analytics": "tsx scripts/analytics.ts",
    "inspect": "tsx scripts/inspect.ts",
    "browser:test": "tsx scripts/browser-test.ts",
    "youtube:smoke": "tsx scripts/youtube-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
