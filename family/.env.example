# Copy to .env.local. Only the two NEXT_PUBLIC_ values are needed by the app.
NEXT_PUBLIC_SUPABASE_URL=https://qjqekazawirrpwnwgbhd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_USKFwTlyUZFxansVpZHWFQ_eBjVjJt6   # public browser key of project "home"; the service-role key is NOT this

# Only for `npm run seed:accounts` (creates the five sign-in accounts). Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Name=email pairs for the seeded members. Mido is already set in the seed.
MEMBER_EMAILS="Dana=dana@example.com,Wafa=wafa@example.com,Luda=luda@example.com,Lilly=lilly@example.com"

# Step 4 — the assistant. Server-only (never NEXT_PUBLIC_). Without it the Ask screen and the
# morning brief say "not set up" and everything else works as before.
# Either name works; the Vercel project uses ANTHROPIC_API_SECRET_KEY.
ANTHROPIC_API_SECRET_KEY=
# Optional: ASSISTANT_MODEL=claude-opus-5-5   ASSISTANT_EFFORT=medium   (low | medium | high)

# Step 6 — push, cron, hub. All server-only except NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Generate the VAPID pair once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=          # same value as VAPID_PUBLIC_KEY (the browser needs it)
VAPID_SUBJECT=mailto:you@example.com
# The cron runs as each member: it needs the service-role key (subscriptions, notifications)
# and the project's JWT secret (Supabase → Settings → API → JWT Secret) to mint member tokens.
SUPABASE_JWT_SECRET=
# Any long random string; Vercel sends it as "Authorization: Bearer" on cron calls.
CRON_SECRET=
# Optional: draft the week every day instead of Sundays (handy while trying it out).
# PLAN_EVERY_DAY=1
# Optional: Home Assistant, read-only. Make a long-lived token for a read-only HA user.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
